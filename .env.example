# Private key akun testnet (MetaMask > Account details > Show private key),
# atau hasil `cast wallet new`. Boleh dengan atau tanpa awalan 0x.
# JANGAN pakai wallet utama. File ini sudah di-gitignore.
PRIVATE_KEY=
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
# Mainnet deployment only; never use a funded production wallet for testing.
MONAD_MAINNET_RPC=https://rpc.monad.xyz
FAUCET_ALLOCATION=200000
# TNC per klaim faucet (default 100)
FAUCET_CLAIM_AMOUNT=100
# Path output deployment JSON (default ../deployments/monadTestnet.json)
DEPLOYMENT_OUT=../deployments/monadTestnet.json
